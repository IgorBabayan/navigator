root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,axaml,yml,yaml,json,iss}]
indent_size = 2

[*.{sh,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Indentation: a braced block under a case label aligns with the label
csharp_indent_case_contents_when_block = false

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# var and expression preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = false:suggestion

# Naming: private fields are _camelCase, constants PascalCase
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.static_readonly.symbols = static_readonly
dotnet_naming_rule.static_readonly.style = pascal
dotnet_naming_rule.static_readonly.severity = warning
dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly

# Analyzer tuning: these rules conflict with intentional design choices documented in docs/ARCHITECTURE.md
dotnet_diagnostic.CA1716.severity = none   # 'Navigator.Core.IO' etc. are fine namespace names
dotnet_diagnostic.CA1031.severity = none   # catch-all is used only at documented error boundaries
dotnet_diagnostic.CA1062.severity = none   # nullable reference types cover argument null checks
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage source generators are used on hot paths only
dotnet_diagnostic.CA1303.severity = none   # user-facing strings go through the localization service
dotnet_diagnostic.CA2007.severity = none   # no SynchronizationContext concerns in desktop app code paths that need ConfigureAwait
dotnet_diagnostic.CA1805.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1515.severity = none   # public types are needed for test projects and XAML compilation
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1003.severity = none
dotnet_diagnostic.CA1028.severity = none
dotnet_diagnostic.CA1308.severity = none   # lower-case normalization is intentional for file extensions
dotnet_diagnostic.CA5350.severity = none   # SHA-1/MD5 are offered only as user-requested file checksums
dotnet_diagnostic.CA5351.severity = none
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.IDE0290.severity = none
