<Project Sdk="Microsoft.NET.Sdk">
  <!--
    FTP plugin: browse FTP and FTPS (explicit TLS) servers. Base class library only, no third-party code.
    Installed from the plugin shop; NOT part of the app build.
    `dotnet publish -c Release` produces artifacts/plugins/navigator-plugin-ftp-{version}.navplugin.
  -->
  <PropertyGroup>
    <RootNamespace>Navigator.Plugin.Ftp</RootNamespace>
    <NavigatorPluginId>ftp</NavigatorPluginId>
    <NavigatorPluginVersion>1.0.0</NavigatorPluginVersion>
    <NavigatorPluginName>FTP</NavigatorPluginName>
    <NavigatorPluginDescription>Browse, upload and download files on FTP and FTPS servers.</NavigatorPluginDescription>
    <NavigatorPluginAuthor>Navigator</NavigatorPluginAuthor>
    <NavigatorPluginEntryType>Navigator.Plugin.Ftp.FtpPlugin</NavigatorPluginEntryType>
    <NavigatorPluginIconKey>ServerFtp</NavigatorPluginIconKey>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host provides the contract (and Navigator.Core) at run time: never copied into the package. -->
    <ProjectReference Include="..\..\src\Navigator.Plugins.Abstractions\Navigator.Plugins.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" LogicalName="Strings.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Navigator.UnitTests" />
  </ItemGroup>
</Project>
