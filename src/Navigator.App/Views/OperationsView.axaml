<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Navigator.App.Controls"
             xmlns:vm="using:Navigator.Presentation.Shell"
             x:Class="Navigator.App.Views.OperationsView"
             x:DataType="vm:OperationsViewModel">
  <StackPanel Margin="12" Spacing="8">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="subtitle" Text="{c:Tr Operations.Title}" />
      <Button Grid.Column="1" Classes="subtle" Content="{c:Tr Operations.ClearFinished}" Command="{Binding ClearFinishedCommand}" />
    </Grid>
    <ScrollViewer MaxHeight="420">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OperationItemViewModel">
            <Border Classes="card" Padding="12" Margin="0,0,0,6">
              <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Classes="caption" Text="{Binding StateText}" />
                <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,4" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding !IsFinished}" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="caption" Margin="0,8,0,0" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding IsFinished}" />
                <Button Grid.Column="1" Grid.RowSpan="2" Classes="subtle icon" Command="{Binding PauseCommand}" IsVisible="{Binding !IsFinished}" ToolTip.Tip="{c:Tr Operations.PauseResume}">
                  <c:IconView Kind="{Binding PauseIconKey}" Width="12" Height="12" />
                </Button>
                <Button Grid.Column="2" Grid.RowSpan="2" Classes="subtle icon" Command="{Binding CancelCommand}" IsVisible="{Binding !IsFinished}" ToolTip.Tip="{c:Tr Dialog.Cancel}">
                  <c:IconView Kind="Close" Width="12" Height="12" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</UserControl>
