<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Navigator.App.Controls"
        xmlns:d="using:Navigator.Presentation.Details"
        xmlns:sys="using:System"
        x:Class="Navigator.App.Views.PropertiesWindow"
        x:DataType="d:PropertiesViewModel"
        Title="{Binding Title}"
        Width="520" Height="640" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Card}">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer" Padding="16,12">
      <Button Classes="accent" HorizontalAlignment="Right" MinWidth="96" Content="{c:Tr Dialog.Close}" Click="OnClose" />
    </Border>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="24,20,24,8">
      <c:IconView Kind="{Binding IconKey}" Width="48" Height="48" />
      <TextBlock Classes="title" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" />
    </StackPanel>

    <!-- Tabs other than General appear only where they apply and load the first time they are selected. -->
    <TabControl x:Name="Tabs" Margin="16,0" SelectionChanged="OnTabChanged">
      <TabItem Header="{c:Tr Properties.General}" Tag="general">
        <ScrollViewer>
          <StackPanel Margin="8,12" Spacing="12">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsCalculating}" />
            <Border Classes="card">
              <ItemsControl ItemsSource="{Binding General}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="d:PropertyRow">
                    <Grid ColumnDefinitions="140,*" Margin="0,4">
                      <TextBlock Classes="caption" Text="{Binding Label}" VerticalAlignment="Top" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <StackPanel IsVisible="{Binding IsSingleFile}" Spacing="8">
              <TextBlock Classes="section" Text="{c:Tr Properties.Hashes}" />
              <Border Classes="card">
                <ItemsControl ItemsSource="{Binding Hashes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="d:HashRowViewModel">
                      <Grid ColumnDefinitions="80,*,Auto" Margin="0,4">
                        <TextBlock Classes="caption" Text="{Binding Name}" VerticalAlignment="Center" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="{DynamicResource Font.Caption}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="subtle" Content="{c:Tr Properties.Compute}" IsEnabled="{Binding !IsComputing}"
                                Command="{Binding $parent[Window].((d:PropertiesViewModel)DataContext).ComputeHashCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Security ─────────────────────────────────────── -->
      <TabItem Header="{c:Tr Properties.Security}" Tag="security" IsVisible="{Binding HasSecurity}">
        <Panel DataContext="{Binding Security}">
        <ScrollViewer x:DataType="d:SecurityTabViewModel">
          <StackPanel Margin="8,12" Spacing="12">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
            <Border Classes="card">
              <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
                <TextBlock Classes="caption" Text="{c:Tr Security.Owner}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Owner}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Classes="caption" Text="{c:Tr Security.Group}" Margin="0,6,0,0" IsVisible="{Binding HasGroup}" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Group}" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding HasGroup}" />
              </Grid>
            </Border>

            <!-- Unix permissions: owner / group / others × read / write / execute -->
            <StackPanel Spacing="8" IsVisible="{Binding HasMode}">
              <TextBlock Classes="section" Text="{c:Tr Security.Permissions}" />
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="120,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Column="1" Classes="caption" Text="{c:Tr Security.Read}" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="{c:Tr Security.Write}" />
                    <TextBlock Grid.Column="3" Classes="caption" Text="{Binding ExecuteLabel}" />
                    <TextBlock Grid.Row="1" Text="{c:Tr Security.Owner}" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding OwnerRead}" />
                    <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding OwnerWrite}" />
                    <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding OwnerExecute}" />
                    <TextBlock Grid.Row="2" Text="{c:Tr Security.Group}" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding GroupRead}" />
                    <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding GroupWrite}" />
                    <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding GroupExecute}" />
                    <TextBlock Grid.Row="3" Text="{c:Tr Security.Others}" VerticalAlignment="Center" />
                    <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding OthersRead}" />
                    <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="{Binding OthersWrite}" />
                    <CheckBox Grid.Row="3" Grid.Column="3" IsChecked="{Binding OthersExecute}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <SelectableTextBlock Text="{Binding ModeText}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{c:Tr Security.Apply}" Command="{Binding ApplyModeCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Windows ACL entries -->
            <StackPanel Spacing="8" IsVisible="{Binding HasRules}">
              <TextBlock Classes="section" Text="{c:Tr Security.Rules}" />
              <Border Classes="card">
                <ItemsControl ItemsSource="{Binding Rules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="d:AccessRuleRow">
                      <StackPanel Margin="0,4" Spacing="1">
                        <Grid ColumnDefinitions="*,Auto">
                          <SelectableTextBlock Text="{Binding Identity}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Access}" Foreground="{DynamicResource Brush.Danger}" IsVisible="{Binding IsDeny}" />
                          <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Access}" IsVisible="{Binding !IsDeny}" />
                        </Grid>
                        <TextBlock Text="{Binding Permissions}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" TextWrapping="Wrap">
                          <Run Text="{Binding AppliesTo}" />
                          <Run Text=" · " />
                          <Run Text="{Binding InheritedText}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasExtendedEntries}">
              <TextBlock Classes="section" Text="{c:Tr Security.Extended}" />
              <Border Classes="card">
                <ItemsControl ItemsSource="{Binding ExtendedEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                      <SelectableTextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAdvancedEditor}">
              <TextBlock Classes="caption" Text="{c:Tr Security.AdvancedDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Margin="12,0,0,0" Content="{c:Tr Security.Advanced}" Command="{Binding OpenAdvancedCommand}" />
            </Grid>
            <TextBlock Classes="caption" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        </Panel>
      </TabItem>

      <!-- ── Digital signatures ───────────────────────────── -->
      <TabItem Header="{c:Tr Properties.Signatures}" Tag="signatures" IsVisible="{Binding HasSignatures}">
        <Panel DataContext="{Binding Signatures}">
        <ScrollViewer x:DataType="d:SignaturesTabViewModel">
          <StackPanel Margin="8,12" Spacing="12">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
            <Border Classes="card" IsVisible="{Binding IsLoaded}">
              <Grid ColumnDefinitions="Auto,*">
                <c:IconView Kind="{Binding StatusIconKey}" Width="32" Height="32" VerticalAlignment="Top"
                            Classes.tone-success="{Binding Tone, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=Success}"
                            Classes.tone-warning="{Binding Tone, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=Warning}"
                            Classes.tone-error="{Binding Tone, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=Error}" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
                  <TextBlock Classes="subtitle" Text="{Binding StatusText}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding StatusDescription}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasSigner}">
              <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Classes="caption" Text="{c:Tr Signature.Signer}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Signer}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Classes="caption" Text="{c:Tr Signature.Issuer}" Margin="0,6,0,0" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Issuer}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Classes="caption" Text="{c:Tr Signature.Time}" Margin="0,6,0,0" />
                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SigningTime}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Grid.Row="3" Classes="caption" Text="{c:Tr Signature.Validity}" Margin="0,6,0,0" />
                <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Validity}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Grid.Row="4" Classes="caption" Text="{c:Tr Signature.Digest}" Margin="0,6,0,0" />
                <SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DigestAlgorithm}" Margin="0,6,0,0" />
                <TextBlock Grid.Row="5" Classes="caption" Text="{c:Tr Signature.Serial}" Margin="0,6,0,0" />
                <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SerialNumber}" TextWrapping="Wrap" FontSize="{DynamicResource Font.Caption}" Margin="0,6,0,0" />
                <TextBlock Grid.Row="6" Classes="caption" Text="{c:Tr Signature.Thumbprint}" Margin="0,6,0,0" />
                <SelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Thumbprint}" TextWrapping="Wrap" FontSize="{DynamicResource Font.Caption}" Margin="0,6,0,0" />
                <TextBlock Grid.Row="7" Classes="caption" Text="{c:Tr Signature.SourceLabel}" Margin="0,6,0,0" />
                <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,6,0,0">
                  <SelectableTextBlock Text="{Binding Source}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding NestedSignaturesText}" IsVisible="{Binding HasNestedSignatures}" />
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Spacing="8" IsVisible="{Binding HasChain}">
              <TextBlock Classes="section" Text="{c:Tr Signature.Chain}" />
              <Border Classes="card">
                <ItemsControl ItemsSource="{Binding Chain}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="d:CertificateRow">
                      <StackPanel Margin="0,4">
                        <SelectableTextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding Validity}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding HasDetails}">
              <TextBlock Classes="section" Text="{c:Tr Signature.Details}" />
              <Border Classes="card">
                <ItemsControl ItemsSource="{Binding Details}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="d:PropertyRow">
                      <Grid ColumnDefinitions="140,*" Margin="0,3">
                        <TextBlock Classes="caption" Text="{Binding Label}" TextWrapping="Wrap" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        </Panel>
      </TabItem>

      <!-- ── Compatibility (Windows programs) ─────────────── -->
      <TabItem Header="{c:Tr Properties.Compatibility}" Tag="compatibility" IsVisible="{Binding HasCompatibility}">
        <Panel DataContext="{Binding Compatibility}">
        <ScrollViewer x:DataType="d:CompatibilityTabViewModel">
          <StackPanel Margin="8,12" Spacing="12">
            <TextBlock Classes="caption" Text="{c:Tr Compatibility.Description}" TextWrapping="Wrap" />
            <Border Classes="card">
              <StackPanel Spacing="8">
                <CheckBox Content="{c:Tr Compatibility.UseMode}" IsChecked="{Binding UseCompatibilityMode}" />
                <ComboBox Margin="28,0,0,0" MinWidth="260" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" IsEnabled="{Binding UseCompatibilityMode}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="section" Text="{c:Tr Compatibility.Settings}" />
            <Border Classes="card">
              <StackPanel Spacing="8">
                <CheckBox Content="{c:Tr Compatibility.ReducedColor}" IsChecked="{Binding UseReducedColor}" />
                <ComboBox Margin="28,0,0,0" MinWidth="220" ItemsSource="{Binding ColorModes}" SelectedItem="{Binding ColorMode}" IsEnabled="{Binding UseReducedColor}" />
                <CheckBox Content="{c:Tr Compatibility.Resolution}" IsChecked="{Binding Resolution640x480}" />
                <CheckBox Content="{c:Tr Compatibility.Fullscreen}" IsChecked="{Binding DisableFullscreenOptimizations}" />
                <CheckBox Content="{c:Tr Compatibility.Admin}" IsChecked="{Binding RunAsAdministrator}" />
                <CheckBox IsChecked="{Binding OverrideDpi}">
                  <TextBlock Text="{c:Tr Compatibility.OverrideDpi}" TextWrapping="Wrap" />
                </CheckBox>
                <ComboBox Margin="28,0,0,0" MinWidth="220" ItemsSource="{Binding DpiOptions}" SelectedItem="{Binding Dpi}" IsEnabled="{Binding OverrideDpi}" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{c:Tr Compatibility.Reset}" Command="{Binding ResetCommand}" />
              <Button Classes="accent" Content="{c:Tr Compatibility.Apply}" Command="{Binding ApplyCommand}" />
            </StackPanel>
            <TextBlock Classes="caption" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        </Panel>
      </TabItem>

      <!-- ── Customize (folders) ──────────────────────────── -->
      <TabItem Header="{c:Tr Properties.Customize}" Tag="customize" IsVisible="{Binding HasFolderIcon}">
        <Panel DataContext="{Binding FolderIcon}">
        <ScrollViewer x:DataType="d:FolderIconTabViewModel">
          <StackPanel Margin="8,12" Spacing="12">
            <TextBlock Classes="section" Text="{c:Tr FolderIcon.Title}" />
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="140,*">
                  <TextBlock Classes="caption" Text="{c:Tr FolderIcon.Current}" VerticalAlignment="Center" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding CurrentIcon}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="140,Auto" IsVisible="{Binding SupportsIconIndex}">
                  <TextBlock Classes="caption" Text="{c:Tr FolderIcon.Index}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Width="80" Text="{Binding IconIndex}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Content="{c:Tr FolderIcon.Change}" Command="{Binding ChangeIconCommand}" />
                  <Button Content="{c:Tr FolderIcon.Restore}" Command="{Binding RestoreDefaultCommand}" />
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding Hint}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
            <TextBlock Classes="caption" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
        </Panel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
