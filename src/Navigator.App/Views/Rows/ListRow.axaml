<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Navigator.App.Controls"
             xmlns:v="using:Navigator.App.Views"
             xmlns:items="using:Navigator.Presentation.Items"
             x:Class="Navigator.App.Views.Rows.ListRow"
             x:DataType="items:FileItemViewModel">
  <c:RowSurface Classes="item" Classes.selected="{Binding IsSelected}" Height="{DynamicResource Size.Row}" ToolTip.Tip="{Binding FullPath}">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0" Opacity="{Binding ContentOpacity}">
      <Border Classes="rowCheck"><c:IconView Kind="Check" /></Border>
      <Panel Grid.Column="1" Width="{StaticResource Size.RowIcon}" Height="{StaticResource Size.RowIcon}" Margin="0,0,10,0">
        <c:IconView Kind="{Binding IconKey}" SystemIcon="{Binding SystemIconKey}" Width="{StaticResource Size.RowIcon}" Height="{StaticResource Size.RowIcon}" IsVisible="{Binding !HasThumbnail}" />
        <Image Source="{Binding Thumbnail, Converter={x:Static v:ImageConverter.Instance}}" IsVisible="{Binding HasThumbnail}" Stretch="UniformToFill" />
      </Panel>
      <TextBlock Grid.Column="2" Classes="itemName" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="3" Classes="caption" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="12,0,0,0" />
    </Grid>
  </c:RowSurface>
</UserControl>
