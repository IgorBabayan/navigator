<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Navigator.App.Controls"
        xmlns:p="using:Navigator.Presentation.SettingsPages"
        xmlns:pl="using:Navigator.Presentation.Plugins"
        x:Class="Navigator.App.Views.SettingsWindow"
        x:DataType="p:SettingsViewModel"
        Title="{c:Tr Command.Settings}"
        Width="980" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}">
  <Window.Styles>
    <Style Selector="Border.setting">
      <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style Selector="Border.setting > Grid > StackPanel > TextBlock.description">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource Font.Caption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="TextBlock.modified">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="StackPanel.page">
      <Setter Property="Margin" Value="32,24,32,32" />
      <Setter Property="MaxWidth" Value="900" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="260,*">
    <!-- Navigation -->
    <DockPanel Margin="12,16,4,12">
      <TextBlock DockPanel.Dock="Top" Classes="title" Text="{c:Tr Command.Settings}" Margin="12,0,0,16" />
      <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="p:SettingsPage">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:IconView Kind="{Binding IconKey}" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <Border Grid.Column="1" Classes="layer">
      <ScrollViewer>
        <Panel>
          <!-- General -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=general}">
            <TextBlock Classes="display" Text="{c:Tr Settings.General}" Margin="0,0,0,16" />
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.Language}" /><TextBlock Classes="description" Text="{c:Tr Settings.LanguageDescription}" /></StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="subtle icon" Margin="4,0,0,0" ToolTip.Tip="{c:Tr Settings.Reset}" Command="{Binding ResetCommand}" CommandParameter="Language"><c:IconView Kind="Undo" /></Button></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.Startup}" /></StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding StartupOptions}" SelectedItem="{Binding Startup}" VerticalAlignment="Center" /></Grid></Border>
            <Border Classes="setting" IsVisible="{Binding IsStartupWithSpecificLocations}"><StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.StartupLocations}" /><TextBlock Classes="description" Text="{c:Tr Settings.StartupLocationsDescription}" /></StackPanel>
                <Button Grid.Column="1" Content="{c:Tr Settings.AddStartupLocation}" Command="{Binding AddStartupLocationCommand}" /></Grid>
              <ItemsControl ItemsSource="{Binding StartupLocations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Classes="subtle icon" ToolTip.Tip="{c:Tr Settings.Remove}"
                              Command="{Binding $parent[Window].((p:SettingsViewModel)DataContext).RemoveStartupLocationCommand}" CommandParameter="{Binding}">
                        <c:IconView Kind="Close" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl></StackPanel></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.OpenFoldersInNewTab}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding OpenFoldersInNewTab}" OnContent="" OffContent="" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.ConfirmCloseTabs}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmCloseWithMultipleTabs}" OnContent="" OffContent="" /></Grid></Border>
            <TextBlock Classes="section" Text="{c:Tr Settings.GlobalShortcutSection}" />
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Command.ActivateApp}" />
                <TextBlock Classes="description" Text="{Binding GlobalShortcutStatus}" IsVisible="{Binding !HasGlobalShortcutProblem}" />
                <TextBlock Classes="error" Text="{Binding GlobalShortcutStatus}" IsVisible="{Binding HasGlobalShortcutProblem}" TextWrapping="Wrap" /></StackPanel>
              <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{c:Tr Settings.ChangeShortcut}" Command="{Binding ChangeGlobalShortcutCommand}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.KeepRunningInBackground}" /><TextBlock Classes="description" Text="{c:Tr Settings.KeepRunningInBackgroundDescription}" /></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepRunningInBackground}" OnContent="" OffContent="" />
              <Button Grid.Column="2" Classes="subtle icon" Margin="4,0,0,0" ToolTip.Tip="{c:Tr Settings.Reset}" Command="{Binding ResetCommand}" CommandParameter="KeepRunningInBackground"><c:IconView Kind="Undo" /></Button></Grid></Border>
            <TextBlock Classes="section" Text="{c:Tr Settings.HomeWidgets}" />
            <Border Classes="setting"><StackPanel Spacing="4">
              <CheckBox Content="{c:Tr Home.QuickAccess}" IsChecked="{Binding ShowHomeQuickAccess}" />
              <CheckBox Content="{c:Tr Home.Drives}" IsChecked="{Binding ShowHomeDrives}" />
              <CheckBox Content="{c:Tr Home.Tags}" IsChecked="{Binding ShowHomeTags}" />
              <CheckBox Content="{c:Tr Home.RecentFiles}" IsChecked="{Binding ShowHomeRecentFiles}" /></StackPanel></Border>
            <TextBlock Classes="section" Text="{c:Tr Settings.ContextMenu}" />
            <Border Classes="setting"><StackPanel Spacing="4">
              <CheckBox Content="{c:Tr Command.OpenInNewWindow}" IsChecked="{Binding ShowOpenInNewWindowInContextMenu}" />
              <CheckBox Content="{c:Tr Command.CopyPath}" IsChecked="{Binding ShowCopyPathInContextMenu}" />
              <CheckBox Content="{c:Tr Command.OpenTerminal}" IsChecked="{Binding ShowOpenTerminalInContextMenu}" /></StackPanel></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.CodeEditor}" /><TextBlock Classes="description" Text="{c:Tr Settings.CodeEditorDescription}" /></StackPanel>
              <TextBox Grid.Column="1" Width="220" Text="{Binding CodeEditorCommand}" PlaceholderText="code" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Omnibar.ClearHistory}" /><TextBlock Classes="description" Text="{c:Tr Settings.AddressHistoryDescription}" /></StackPanel>
              <Button Grid.Column="1" Content="{c:Tr Settings.Clear}" Command="{Binding ClearAddressHistoryCommand}" /></Grid></Border>
          </StackPanel>

          <!-- Appearance -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=appearance}">
            <TextBlock Classes="display" Text="{c:Tr Settings.Appearance}" Margin="0,0,0,16" />
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{c:Tr Settings.Theme}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="subtle icon" Margin="4,0,0,0" ToolTip.Tip="{c:Tr Settings.Reset}" Command="{Binding ResetCommand}" CommandParameter="Theme"><c:IconView Kind="Undo" /></Button></Grid></Border>
            <Border Classes="setting"><StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.AccentColor}" VerticalAlignment="Center" /><CheckBox Grid.Column="1" Content="{c:Tr Settings.UseSystemAccent}" IsChecked="{Binding UseSystemAccent}" /></Grid>
              <ItemsControl ItemsSource="{Binding AccentPresets}" IsVisible="{Binding !UseSystemAccent}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Width="32" Height="32" MinHeight="32" Margin="0,0,6,6" CornerRadius="16" Padding="0"
                            Background="{Binding Converter={x:Static c:HexToBrushConverter.Instance}}"
                            Command="{Binding $parent[Window].((p:SettingsViewModel)DataContext).PickAccentCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl></StackPanel></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.Backdrop}" /><TextBlock Classes="description" Text="{c:Tr Settings.BackdropDescription}" /></StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Backdrops}" SelectedItem="{Binding Backdrop}" VerticalAlignment="Center" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.Transparency}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Width="220" Minimum="0" Maximum="1" Value="{Binding Transparency}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.BackgroundColor}" /><TextBlock Classes="description" Text="{c:Tr Settings.BackgroundColorDescription}" /></StackPanel>
              <TextBox Grid.Column="1" Width="140" Text="{Binding BackgroundColor}" PlaceholderText="#RRGGBB" /></Grid></Border>
            <Border Classes="setting"><StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{c:Tr Settings.BackgroundImage}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{c:Tr Settings.Browse}" Command="{Binding PickBackgroundImageCommand}" />
                <Button Grid.Column="2" Classes="subtle icon" Margin="4,0,0,0" ToolTip.Tip="{c:Tr Settings.Reset}" Command="{Binding ResetCommand}" CommandParameter="BackgroundImagePath"><c:IconView Kind="Undo" /></Button></Grid>
              <TextBlock Classes="caption" Text="{Binding BackgroundImagePath}" TextTrimming="CharacterEllipsis" />
              <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundImageOpacity}" /></StackPanel></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.Density}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Densities}" SelectedItem="{Binding Density}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.Animations}" /><TextBlock Classes="description" Text="{c:Tr Settings.AnimationsDescription}" /></StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding AnimationLevels}" SelectedItem="{Binding Animations}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{c:Tr Settings.FontFamily}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}" MaxDropDownHeight="360" VerticalAlignment="Center" />
              <Button Grid.Column="2" Classes="subtle icon" Margin="4,0,0,0" ToolTip.Tip="{c:Tr Settings.Reset}" Command="{Binding ResetCommand}" CommandParameter="FontFamily"><c:IconView Kind="Undo" /></Button></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.FontScale}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Width="220" Minimum="0.75" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding FontScale}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.ToolbarLabels}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowToolbarLabels}" OnContent="" OffContent="" /></Grid></Border>
          </StackPanel>

          <!-- Files and folders -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=files}">
            <TextBlock Classes="display" Text="{c:Tr Settings.FilesAndFolders}" Margin="0,0,0,16" />
            <Border Classes="setting"><StackPanel Spacing="4">
              <CheckBox Content="{c:Tr Settings.ShowHiddenItems}" IsChecked="{Binding ShowHiddenItems}" />
              <CheckBox Content="{c:Tr Settings.ShowDotFiles}" IsChecked="{Binding ShowDotFiles}" />
              <CheckBox Content="{c:Tr Settings.ShowProtectedSystemItems}" IsChecked="{Binding ShowProtectedSystemItems}" IsVisible="{Binding IsProtectedSystemItemsSupported}" />
              <CheckBox Content="{c:Tr Settings.ShowFileExtensions}" IsChecked="{Binding ShowFileExtensions}" />
              <CheckBox Content="{c:Tr Settings.ShowThumbnails}" IsChecked="{Binding ShowThumbnails}" />
              <CheckBox Content="{c:Tr Settings.ShowCheckBoxes}" IsChecked="{Binding ShowCheckBoxes}" />
              <CheckBox Content="{c:Tr Settings.ShowTagsColumn}" IsChecked="{Binding ShowFileTagsColumn}" /></StackPanel></Border>
            <Border Classes="setting"><StackPanel Spacing="4">
              <CheckBox Content="{c:Tr Settings.SingleClick}" IsChecked="{Binding OpenItemsWithSingleClick}" />
              <CheckBox Content="{c:Tr Settings.DoubleClickUp}" IsChecked="{Binding DoubleClickEmptyAreaGoesUp}" />
              <CheckBox Content="{c:Tr Settings.FolderSizes}" IsChecked="{Binding CalculateFolderSizes}" />
              <CheckBox Content="{c:Tr Settings.ConfirmDelete}" IsChecked="{Binding ConfirmDelete}" /></StackPanel></Border>
            <TextBlock Classes="section" Text="{c:Tr Settings.DefaultView}" />
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Command.Layout}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Layouts}" SelectedItem="{Binding DefaultLayout}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{c:Tr Command.Sort}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SortColumns}" SelectedItem="{Binding DefaultSortColumn}" />
              <CheckBox Grid.Column="2" Margin="12,0,0,0" Content="{c:Tr Sort.Descending}" IsChecked="{Binding DefaultSortDescending}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Command.Group}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding DefaultGroupBy}" /></Grid></Border>
            <Border Classes="setting"><StackPanel Spacing="4">
              <CheckBox Content="{c:Tr Sort.FoldersFirst}" IsChecked="{Binding ListFoldersFirst}" />
              <CheckBox Content="{c:Tr Settings.RememberViewPerFolder}" IsChecked="{Binding RememberViewPerFolder}" /></StackPanel></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.ForgetFolderViews}" /><TextBlock Classes="description" Text="{c:Tr Settings.ForgetFolderViewsDescription}" /></StackPanel>
              <Button Grid.Column="1" Content="{c:Tr Settings.Clear}" Command="{Binding ClearFolderViewsCommand}" /></Grid></Border>
          </StackPanel>

          <!-- Sidebar -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=sidebar}">
            <TextBlock Classes="display" Text="{c:Tr Settings.Sidebar}" Margin="0,0,0,16" />
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.ShowSidebar}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SidebarIsVisible}" OnContent="" OffContent="" /></Grid></Border>
            <Border Classes="setting"><StackPanel Spacing="4">
              <CheckBox Content="{c:Tr Sidebar.Pinned}" IsChecked="{Binding SidebarShowQuickAccess}" />
              <CheckBox Content="{c:Tr Sidebar.Drives}" IsChecked="{Binding SidebarShowDrives}" />
              <CheckBox Content="{c:Tr Sidebar.Network}" IsChecked="{Binding SidebarShowNetwork}" />
              <CheckBox Content="{c:Tr Sidebar.Tags}" IsChecked="{Binding SidebarShowTags}" />
              <CheckBox Content="{c:Tr Location.Trash}" IsChecked="{Binding SidebarShowTrash}" /></StackPanel></Border>
          </StackPanel>

          <!-- File operations -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=operations}">
            <TextBlock Classes="display" Text="{c:Tr Settings.Operations}" Margin="0,0,0,16" />
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,40"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.Concurrency}" /><TextBlock Classes="description" Text="{c:Tr Settings.ConcurrencyDescription}" /></StackPanel>
              <Slider Grid.Column="1" Width="200" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxConcurrentOperations}" />
              <TextBlock Grid.Column="2" Text="{Binding MaxConcurrentOperations}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.VerifyMoves}" /><TextBlock Classes="description" Text="{c:Tr Settings.VerifyMovesDescription}" /></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding VerifyMovedFileContents}" OnContent="" OffContent="" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.NotifyCompleted}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowOperationCompletedNotification}" OnContent="" OffContent="" /></Grid></Border>
          </StackPanel>

          <!-- Search -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=search}">
            <TextBlock Classes="display" Text="{c:Tr Settings.Search}" Margin="0,0,0,16" />
            <Border Classes="setting"><StackPanel Spacing="4">
              <CheckBox Content="{c:Tr Settings.SearchSubfolders}" IsChecked="{Binding SearchIncludeSubfolders}" />
              <CheckBox Content="{c:Tr Settings.SearchContents}" IsChecked="{Binding SearchFileContents}" />
              <CheckBox Content="{c:Tr Settings.SearchHistory}" IsChecked="{Binding SearchKeepHistory}" /></StackPanel></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,60"><TextBlock Text="{c:Tr Settings.SearchMaxResults}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Width="200" Minimum="100" Maximum="50000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding SearchMaxResults}" />
              <TextBlock Grid.Column="2" Text="{Binding SearchMaxResults}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border>
            <Button Content="{c:Tr Settings.ClearSearchHistory}" Command="{Binding ClearSearchHistoryCommand}" />
          </StackPanel>

          <!-- Tags -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=tags}">
            <TextBlock Classes="display" Text="{c:Tr Settings.Tags}" Margin="0,0,0,16" />
            <ItemsControl ItemsSource="{Binding TagRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:TagRowViewModel">
                  <Border Classes="setting">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <Ellipse Width="14" Height="14" Margin="0,0,12,0" Fill="{Binding Color, Converter={x:Static c:HexToBrushConverter.Instance}}" />
                      <TextBox Grid.Column="1" Text="{Binding Name}" />
                      <TextBox Grid.Column="2" Width="110" Margin="8,0" Text="{Binding Color}" />
                      <Button Grid.Column="3" Classes="subtle icon" ToolTip.Tip="{c:Tr Settings.RemoveTag}"
                              Command="{Binding $parent[Window].((p:SettingsViewModel)DataContext).RemoveTagCommand}" CommandParameter="{Binding}">
                        <c:IconView Kind="Delete" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="accent" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{c:Tr Settings.AddTag}" Command="{Binding AddTagCommand}" />
          </StackPanel>

          <!-- Keyboard shortcuts -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=keyboard}">
            <TextBlock Classes="display" Text="{c:Tr Settings.Keyboard}" Margin="0,0,0,8" />
            <TextBlock Classes="caption" Text="{c:Tr Settings.KeyboardDescription}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <TextBox x:Name="KeyBindingSearch" Classes="clearButton" Text="{Binding KeyBindingFilter}" PlaceholderText="{c:Tr Settings.SearchShortcuts}">
                <TextBox.InnerLeftContent>
                  <c:IconView Kind="Search" Width="14" Height="14" Margin="10,0,2,0" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <Button Grid.Column="1" Margin="8,0,0,0" Content="{c:Tr Settings.ResetShortcuts}" Command="{Binding ResetAllKeyBindingsCommand}" />
            </Grid>
            <TextBlock Classes="error" Text="{Binding KeyBindingConflicts}" IsVisible="{Binding HasKeyBindingConflicts}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Classes="caption" Text="{c:Tr Settings.NoShortcutsFound}" IsVisible="{Binding !HasKeyBindingResults}" Margin="0,8" />
            <ItemsControl ItemsSource="{Binding KeyBindings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:KeyBindingRowViewModel">
                  <Border Classes="setting" MinHeight="48" IsVisible="{Binding IsVisible}">
                    <Grid ColumnDefinitions="*,220,Auto,Auto">
                      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" Classes.modified="{Binding IsModified}" />
                        <TextBlock Classes="description" Text="{Binding Category}" />
                        <TextBlock Classes="description" IsVisible="{Binding IsModified}" Text="{Binding DefaultGesturesCaption}" />
                        <TextBlock Classes="error" Text="{c:Tr Settings.ShortcutConflict}" IsVisible="{Binding HasConflict}" />
                        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Panel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Text="{Binding Gestures, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" PlaceholderText="{c:Tr Settings.ShortcutNotAssigned}"
                                 IsVisible="{Binding !IsRecording}" KeyDown="OnGestureBoxKeyDown" />
                        <Border Classes="card" Padding="10,6" IsVisible="{Binding IsRecording}" BorderBrush="{DynamicResource Accent.Brush}" BorderThickness="1">
                          <TextBlock Classes="caption" Text="{c:Tr Settings.PressShortcut}" TextWrapping="Wrap" />
                        </Border>
                      </Panel>
                      <Button Grid.Column="2" Classes="subtle icon" Margin="4,0,0,0" ToolTip.Tip="{c:Tr Settings.RecordShortcut}"
                              Command="{Binding $parent[Window].((p:SettingsViewModel)DataContext).RecordKeyBindingCommand}" CommandParameter="{Binding}">
                        <c:IconView Kind="Keyboard" />
                      </Button>
                      <Button Grid.Column="3" Classes="subtle icon" Margin="4,0,0,0" ToolTip.Tip="{c:Tr Settings.Reset}" IsEnabled="{Binding IsModified}"
                              Command="{Binding $parent[Window].((p:SettingsViewModel)DataContext).ResetKeyBindingCommand}" CommandParameter="{Binding}">
                        <c:IconView Kind="Undo" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Performance -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=performance}">
            <TextBlock Classes="display" Text="{c:Tr Settings.Performance}" Margin="0,0,0,16" />
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,60"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.ThumbnailMemory}" /><TextBlock Classes="description" Text="{c:Tr Settings.ThumbnailMemoryDescription}" /></StackPanel>
              <Slider Grid.Column="1" Width="200" Minimum="16" Maximum="1024" TickFrequency="16" IsSnapToTickEnabled="True" Value="{Binding ThumbnailMemoryCacheMegabytes}" />
              <TextBlock Grid.Column="2" Text="{Binding ThumbnailMemoryCacheMegabytes, StringFormat='{}{0} MB'}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,72,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.ThumbnailDisk}" /><TextBlock Classes="description" Text="{c:Tr Settings.ThumbnailDiskDescription}" TextWrapping="Wrap" /></StackPanel>
              <Slider Grid.Column="1" Width="200" Minimum="0" Maximum="4096" TickFrequency="64" IsSnapToTickEnabled="True" Value="{Binding ThumbnailDiskCacheMegabytes}" />
              <TextBlock Grid.Column="2" Text="{Binding ThumbnailDiskCacheMegabytes, StringFormat='{}{0} MB'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
              <Button Grid.Column="3" Margin="12,0,0,0" Content="{c:Tr Settings.Clear}" Command="{Binding ClearThumbnailCacheCommand}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,60"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.DirectoryCache}" /><TextBlock Classes="description" Text="{c:Tr Settings.DirectoryCacheDescription}" TextWrapping="Wrap" /></StackPanel>
              <Slider Grid.Column="1" Width="200" Minimum="0" Maximum="256" TickFrequency="8" IsSnapToTickEnabled="True" Value="{Binding DirectoryCacheEntries}" />
              <TextBlock Grid.Column="2" Text="{Binding DirectoryCacheEntries}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,60"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.BackgroundWorkers}" /><TextBlock Classes="description" Text="{c:Tr Settings.RestartRequired}" /></StackPanel>
              <Slider Grid.Column="1" Width="200" Minimum="1" Maximum="{Binding ProcessorCount}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxBackgroundWorkers}" />
              <TextBlock Grid.Column="2" Text="{Binding MaxBackgroundWorkers}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.PerformanceOverlay}" /><TextBlock Classes="description" Text="{c:Tr Settings.PerformanceOverlayDescription}" TextWrapping="Wrap" /></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowPerformanceOverlay}" OnContent="" OffContent="" /></Grid></Border>
          </StackPanel>

          <!-- Plugins (plugin shop) -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=plugins}">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
              <TextBlock Classes="display" Text="{c:Tr Settings.Plugins}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{c:Tr Plugins.InstallFromFile}" Command="{Binding Plugins.InstallFromFileCommand}" />
                <Button Content="{c:Tr Plugins.Refresh}" Command="{Binding Plugins.RefreshCommand}" IsVisible="{Binding Plugins.IsShopConfigured}" />
              </StackPanel>
            </Grid>

            <!-- Progress, result and errors of the last action -->
            <Border Classes="setting" MinHeight="0" IsVisible="{Binding Plugins.IsBusy}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Plugins.StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Classes="subtle" Content="{c:Tr Dialog.Cancel}" Command="{Binding Plugins.CancelCommand}" />
                </Grid>
                <ProgressBar Value="{Binding Plugins.Progress}" IsIndeterminate="{Binding Plugins.IsProgressIndeterminate}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="caption" Margin="4,0,0,8" Text="{Binding Plugins.StatusText}" TextWrapping="Wrap"
                       IsVisible="{Binding !Plugins.IsBusy}" />
            <TextBlock Classes="error" Margin="4,0,0,8" Text="{Binding Plugins.ErrorText}" TextWrapping="Wrap" IsVisible="{Binding Plugins.HasError}" />
            <TextBlock Classes="caption" Margin="4,0,0,8" Text="{c:Tr Plugins.RestartPending}" TextWrapping="Wrap" IsVisible="{Binding Plugins.IsRestartPending}" />

            <!-- Installed -->
            <TextBlock Classes="subtitle" Text="{c:Tr Plugins.Installed}" Margin="0,8,0,8" />
            <ItemsControl ItemsSource="{Binding Plugins.Installed}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pl:PluginRowViewModel">
                  <Border Classes="setting">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <c:IconView Kind="{Binding IconKey}" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="description" Text="{Binding Version}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Classes="description" Text="{Binding Description}" />
                        <TextBlock Classes="description" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="accent" IsVisible="{Binding HasUpdate}"
                                Command="{Binding $parent[Window].((p:SettingsViewModel)DataContext).Plugins.UpdateCommand}" CommandParameter="{Binding}">
                          <TextBlock Text="{Binding UpdateText}" />
                        </Button>
                        <Button Content="{c:Tr Plugins.Remove}" IsVisible="{Binding CanRemove}"
                                Command="{Binding $parent[Window].((p:SettingsViewModel)DataContext).Plugins.RemoveCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Available from the catalog -->
            <TextBlock Classes="subtitle" Text="{c:Tr Plugins.Available}" Margin="0,16,0,8" />
            <TextBlock Classes="caption" Margin="4,0,0,8" Text="{c:Tr Plugins.ShopUnavailable}" TextWrapping="Wrap" IsVisible="{Binding !Plugins.IsShopConfigured}" />
            <TextBlock Classes="caption" Margin="4,0,0,8" Text="{c:Tr Plugins.NothingAvailable}" TextWrapping="Wrap"
                       IsVisible="{Binding Plugins.IsCatalogEmpty}" />
            <ItemsControl ItemsSource="{Binding Plugins.Available}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pl:PluginRowViewModel">
                  <Border Classes="setting">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <c:IconView Kind="{Binding IconKey}" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="description" Text="{Binding Version}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Classes="description" Text="{Binding Description}" />
                        <TextBlock Classes="description" Text="{Binding Author}" />
                        <TextBlock Classes="description" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="accent" VerticalAlignment="Center" Content="{c:Tr Plugins.Install}"
                              Command="{Binding $parent[Window].((p:SettingsViewModel)DataContext).Plugins.InstallCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption" Margin="4,8,0,0" Text="{Binding Plugins.CatalogSourceText}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Updates -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=updates}">
            <TextBlock Classes="display" Text="{c:Tr Settings.Updates}" Margin="0,0,0,16" />
            <Border Classes="setting">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Update.StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="description" Text="{Binding Update.CurrentVersion, StringFormat='Navigator {0}'}" />
                    <TextBlock Classes="description" Text="{Binding Update.InstallationKind}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{c:Tr Update.Check}" Command="{Binding Update.CheckCommand}" />
                    <Button Classes="accent" Content="{c:Tr Update.Download}" Command="{Binding Update.DownloadCommand}" />
                    <Button Classes="accent" Content="{c:Tr Update.Restart}" Command="{Binding Update.RestartCommand}" />
                    <Button Classes="subtle" Content="{c:Tr Dialog.Cancel}" Command="{Binding Update.CancelCommand}" IsVisible="{Binding Update.IsBusy}" />
                  </StackPanel>
                </Grid>
                <ProgressBar Value="{Binding Update.Progress}" IsVisible="{Binding Update.IsBusy}" />
                <TextBlock Classes="caption" Text="{Binding Update.ProgressText}" IsVisible="{Binding Update.IsBusy}" />
                <TextBlock Classes="caption" Text="{c:Tr Update.SignatureVerified}" IsVisible="{Binding Update.IsSignatureVerified}" />
                <TextBlock Classes="caption" Text="{c:Tr Update.ChecksumOnly}" IsVisible="{Binding Update.IsChecksumOnly}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding Update.ReleaseNotes}" TextWrapping="Wrap" MaxHeight="240" />
                <Button Classes="subtle" HorizontalAlignment="Left" Content="{c:Tr Update.Skip}" Command="{Binding Update.SkipVersionCommand}" />
              </StackPanel>
            </Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.CheckOnStartup}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdatesOnStartup}" OnContent="" OffContent="" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,40"><TextBlock Text="{c:Tr Settings.CheckInterval}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Width="200" Minimum="0" Maximum="168" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding UpdateCheckIntervalHours}" />
              <TextBlock Grid.Column="2" Text="{Binding UpdateCheckIntervalHours}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{c:Tr Settings.Channel}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" /></Grid></Border>
            <Border Classes="setting" IsVisible="{Binding SkippedVersion, Converter={x:Static ObjectConverters.IsNotNull}}"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.SkippedVersion}" /><TextBlock Classes="description" Text="{Binding SkippedVersion}" /></StackPanel>
              <Button Grid.Column="1" Content="{c:Tr Settings.Clear}" Command="{Binding ClearSkippedVersionCommand}" /></Grid></Border>
          </StackPanel>

          <!-- Advanced -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=advanced}">
            <TextBlock Classes="display" Text="{c:Tr Settings.Advanced}" Margin="0,0,0,16" />
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.LogLevel}" /><TextBlock Classes="description" Text="{Binding LogDirectory}" /></StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" />
              <Button Grid.Column="2" Margin="8,0,0,0" Content="{c:Tr Settings.OpenLogFolder}" Command="{Binding OpenLogFolderCommand}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto,Auto,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.Backup}" /><TextBlock Classes="description" Text="{Binding SettingsDirectory}" /></StackPanel>
              <Button Grid.Column="1" Content="{c:Tr Settings.Export}" Command="{Binding ExportCommand}" />
              <Button Grid.Column="2" Margin="8,0,0,0" Content="{c:Tr Settings.Import}" Command="{Binding ImportCommand}" />
              <Button Grid.Column="3" Margin="8,0,0,0" Content="{c:Tr Settings.OpenSettingsFolder}" Command="{Binding OpenSettingsFolderCommand}" /></Grid></Border>
            <Border Classes="setting"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center"><TextBlock Text="{c:Tr Settings.ResetAll}" /><TextBlock Classes="description" Text="{c:Tr Settings.ResetAllMessage}" /></StackPanel>
              <Button Grid.Column="1" Classes="danger" Content="{c:Tr Settings.ResetAll}" Command="{Binding ResetAllCommand}" /></Grid></Border>
          </StackPanel>

          <!-- About -->
          <StackPanel Classes="page" IsVisible="{Binding SelectedPage.Id, Converter={x:Static c:EqualsConverter.Instance}, ConverterParameter=about}" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
              <Image Source="/Assets/navigator-256.png" Width="64" Height="64" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="display" Text="Navigator" />
                <TextBlock Classes="caption" Text="{Binding AppVersion}" />
              </StackPanel>
            </StackPanel>
            <Border Classes="setting"><StackPanel Spacing="4">
              <TextBlock Text="{Binding RuntimeVersion}" />
              <TextBlock Classes="caption" Text="{Binding OperatingSystemText}" /></StackPanel></Border>
            <Border Classes="setting"><TextBlock Text="{c:Tr About.Description}" TextWrapping="Wrap" /></Border>
            <Border Classes="setting"><TextBlock Text="{c:Tr About.Licenses}" TextWrapping="Wrap" /></Border>
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
