<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Navigator.App.Controls"
             x:Class="Navigator.App.Views.PerformanceIndicator"
             IsVisible="False">
  <!--
    Status bar performance indicator (Settings → Performance → "Show performance diagnostics").
    Lives in its own status bar column, so it never covers content. Text is updated from code twice a second;
    the tooltip has the full breakdown.
  -->
  <Border x:Name="Chip" Padding="8,0" Height="22" VerticalAlignment="Center" CornerRadius="{StaticResource Radius.Control}"
          Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <c:FrameTimeGraph x:Name="Graph" Width="72" Height="14" VerticalAlignment="Center"
                        Foreground="{DynamicResource Accent.Brush}" WarningBrush="{DynamicResource Brush.Warning}" GuideBrush="{DynamicResource Brush.Stroke}" />
      <TextBlock x:Name="Summary" Classes="caption" VerticalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
