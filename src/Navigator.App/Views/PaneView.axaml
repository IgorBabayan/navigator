<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Navigator.App.Controls"
             xmlns:v="using:Navigator.App.Views"
             xmlns:panes="using:Navigator.Presentation.Panes"
             xmlns:sort="using:Navigator.Core.Sorting"
             x:Class="Navigator.App.Views.PaneView"
             x:DataType="panes:PaneViewModel"
             Focusable="True">
  <UserControl.Styles>
    <!--
      Brushes come from styles (not a local value set in code), so the accent resolves through the normal
      resource lookup even when the pane is created before it joins the visual tree (session restore),
      and follows accent/theme changes without extra code.
    -->
    <Style Selector="Border#PaneHeader">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    </Style>
    <Style Selector="Border#PaneHeader.active">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
    </Style>

    <!--
      Settings → Files and folders → "Show check boxes": a check box in front of each item toggles its selection
      (like Ctrl+click). Hidden (not laid out) unless the pane has the "checkboxes" class.
    -->
    <Style Selector="Border.rowCheck">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeStrong}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Layer}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="v|PaneView.checkboxes Border.rowCheck">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.rowCheck > c|IconView">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.ForegroundBrush}" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.item.selected Border.rowCheck">
      <Setter Property="Background" Value="{DynamicResource Accent.Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
    </Style>
    <Style Selector="Border.item.selected Border.rowCheck > c|IconView">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.item:pointerover Border.rowCheck">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
    </Style>

    <!--
      Drop overlay (drag and drop). Shown only while something droppable is dragged over the list: a tinted, dashed
      frame means "drops into this folder"; over a sub-folder the frame steps aside (the folder itself is outlined) and
      the card names that folder instead. Opacity/transform only, so showing it never relays out the list.
    -->
    <Style Selector="TextBox.inlineRename">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="AcceptsReturn" Value="False" />
      <Setter Property="AcceptsTab" Value="False" />
    </Style>
    <Style Selector="TextBox.inlineRename.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    </Style>
    <Style Selector="TextBox.inlineRename.invalid:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <!--
      Column layout: folders of the current column end in a chevron (the host is hidden in the other layouts, so rows
      keep one template); the columns left of it highlight the entry the trail goes through.
    -->
    <Style Selector="Panel.columnChevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="v|PaneView.columns Panel.columnChevron">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.trailColumn">
      <Setter Property="Width" Value="240" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    </Style>

    <Style Selector="Panel#DropOverlay">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions" Value="{DynamicResource Motion.Fade}" />
    </Style>
    <Style Selector="Panel#DropOverlay.shown">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Panel#DropFrame">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions" Value="{DynamicResource Motion.Fade}" />
    </Style>
    <Style Selector="Panel#DropOverlay.folder Panel#DropFrame">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border#DropCard">
      <Setter Property="RenderTransform" Value="translateY(10px)" />
      <Setter Property="Transitions" Value="{DynamicResource Motion.FadeAndMove}" />
    </Style>
    <Style Selector="Panel#DropOverlay.shown Border#DropCard">
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- Split view: each pane shows its own location; the active one is underlined with the accent. -->
    <Border x:Name="PaneHeader" Grid.Row="0" IsVisible="False" Padding="16,8" BorderThickness="0,0,0,2">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Folder filter (Ctrl+Shift+F) -->
    <Grid x:Name="FilterBar" Grid.Row="1" IsVisible="False" ColumnDefinitions="*,Auto" Margin="12,8,12,0">
      <TextBox x:Name="FilterBox" Text="{Binding FilterText}" PlaceholderText="{c:Tr Pane.FilterPlaceholder}" KeyDown="OnFilterKeyDown" />
      <Button Grid.Column="1" Classes="subtle icon" Margin="4,0,0,0" Click="OnCloseFilter" ToolTip.Tip="{c:Tr Dialog.Close}">
        <c:IconView Kind="Close" Width="12" Height="12" />
      </Button>
    </Grid>

    <!-- Details column header: click sorts, drag the separators to resize. -->
    <Border Grid.Row="2" IsVisible="{Binding IsDetailsLayout}" Padding="16,0,12,0" Height="34" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Stroke}">
      <!-- Cells follow Columns.Order: drag a header sideways to move its column (the name column stays first). -->
      <c:DetailsCellsPanel x:Name="HeaderRow" IsVisible="{Binding IsBrowsingList}" Order="{Binding $parent[v:PaneView].Columns.Order}">
        <v:ColumnHeader x:Name="NameHeader" c:DetailsCellsPanel.Cell="name" ColumnId="name" Column="Name" Text="{c:Tr Column.Name}" Width="{Binding $parent[v:PaneView].Columns.NameWidth}" />
        <v:ColumnHeader x:Name="ModifiedHeader" c:DetailsCellsPanel.Cell="modified" ColumnId="modified" Column="DateModified" Text="{c:Tr Column.Modified}" Width="{Binding $parent[v:PaneView].Columns.ModifiedWidth}" />
        <v:ColumnHeader x:Name="TypeHeader" c:DetailsCellsPanel.Cell="type" ColumnId="type" Column="Type" Text="{c:Tr Column.Type}" Width="{Binding $parent[v:PaneView].Columns.TypeWidth}" />
        <v:ColumnHeader x:Name="SizeHeader" c:DetailsCellsPanel.Cell="size" ColumnId="size" Column="Size" Text="{c:Tr Column.Size}" Width="{Binding $parent[v:PaneView].Columns.SizeWidth}" />
        <v:ColumnHeader x:Name="CreatedHeader" c:DetailsCellsPanel.Cell="created" ColumnId="created" Column="DateCreated" Text="{c:Tr Column.Created}" Width="{Binding $parent[v:PaneView].Columns.CreatedWidth}" IsVisible="{Binding $parent[v:PaneView].Columns.ShowCreated}" />
        <v:ColumnHeader x:Name="TagsHeader" c:DetailsCellsPanel.Cell="tags" ColumnId="tags" Column="Name" Text="{c:Tr Column.Tags}" Width="{Binding $parent[v:PaneView].Columns.TagsWidth}" IsVisible="{Binding $parent[v:PaneView].Columns.ShowTags}" IsSortable="False" />
        <!-- Headers of plugin columns (PluginColumns.Visible), created in code: they follow the built-in columns. -->
        <StackPanel x:Name="PluginHeaders" Orientation="Horizontal" />
      </c:DetailsCellsPanel>
    </Border>

    <Panel Grid.Row="3">
      <Panel IsVisible="{Binding IsHome}">
        <v:HomeView DataContext="{Binding Home}" />
      </Panel>

      <Grid IsVisible="{Binding IsBrowsingList}" ColumnDefinitions="Auto,*">
      <!--
        Column (Miller) layout: one read-only column per folder between the column anchor and the current folder,
        scrolled so the newest stays in view; the current folder itself is the list on the right.
      -->
      <ScrollViewer x:Name="TrailScroller" Grid.Column="0" IsVisible="{Binding HasTrailColumns}"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="TrailHost" ItemsSource="{Binding TrailColumns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="panes:MillerColumnViewModel">
              <Border Classes="trailColumn">
                <Panel>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Entries}" Padding="0,4,0,24">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="panes:ColumnEntryViewModel">
                          <c:RowSurface Classes="item" Classes.selected="{Binding IsOpen}" Height="{DynamicResource Size.Row}" ToolTip.Tip="{Binding Item.FullPath}">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,8,0">
                              <c:IconView Kind="{Binding Item.IconKey}" SystemIcon="{Binding Item.SystemIconKey}" Width="{StaticResource Size.RowIcon}" Height="{StaticResource Size.RowIcon}" Margin="0,0,10,0" />
                              <TextBlock Grid.Column="1" Text="{Binding Item.DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              <c:IconView Grid.Column="2" Kind="ChevronRight" Width="12" Height="12" Opacity="0.7" Margin="8,0,0,0" IsVisible="{Binding Item.IsDirectory}" />
                            </Grid>
                          </c:RowSurface>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" />
                  <TextBlock Classes="secondary" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                             TextAlignment="Center" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Panel Grid.Column="1">
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent">
          <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Rows}" Padding="0,4,0,24">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>

        <!-- Drop overlay: frame for "into this folder", card saying what the drop does (see the styles above). -->
        <Panel x:Name="DropOverlay" IsHitTestVisible="False">
          <Panel x:Name="DropFrame" Margin="6">
            <Border CornerRadius="10" Background="{DynamicResource Accent.SubtleBrush}" />
            <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="2" StrokeDashArray="4,3" Stroke="{DynamicResource Accent.Brush}" />
          </Panel>
          <Border x:Name="DropCard" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,22" Padding="12,10,16,10"
                  CornerRadius="12" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Accent.Brush}" BorderThickness="1"
                  BoxShadow="{StaticResource Shadow.Flyout}">
            <Grid ColumnDefinitions="Auto,*">
              <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0" VerticalAlignment="Center" Background="{DynamicResource Accent.Brush}">
                <c:IconView x:Name="DropIcon" Kind="Copy" Width="18" Height="18" Foreground="{DynamicResource Accent.ForegroundBrush}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="DropTitle" FontWeight="SemiBold" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DropHint" Classes="caption secondary" />
              </StackPanel>
            </Grid>
          </Border>
        </Panel>

        <!--
          In-place rename (F2): one editor for the whole pane, laid over the name of the item being renamed. Rows stay
          plain text blocks, so realizing and recycling them costs nothing extra.
        -->
        <Canvas x:Name="RenameCanvas">
          <TextBox x:Name="RenameBox" Classes="inlineRename" IsVisible="False" />
          <Border x:Name="RenameError" IsVisible="False" IsHitTestVisible="False" MaxWidth="320" Padding="10,6" CornerRadius="6"
                  Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Danger}" BorderThickness="1"
                  BoxShadow="{StaticResource Shadow.Flyout}">
            <TextBlock x:Name="RenameErrorText" TextWrapping="Wrap" FontSize="{DynamicResource Font.Caption}" />
          </Border>
        </Canvas>

        <!-- Rubber-band selection rectangle -->
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
          <Border x:Name="SelectionRectangle" IsVisible="False" Background="{DynamicResource Accent.SubtleBrush}"
                  BorderBrush="{DynamicResource Accent.Brush}" BorderThickness="1" CornerRadius="2" />
        </Canvas>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" Margin="0" />

        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
          <c:IconView Kind="Folder" Width="56" Height="56" Opacity="0.6" />
          <TextBlock Classes="secondary" Text="{Binding EmptyText}" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasError}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
          <c:IconView Kind="Warning" Width="40" Height="40" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" TextAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="{c:Tr Command.Back}" Command="{Binding GoBackCommand}" />
            <Button Classes="accent" Content="{c:Tr Command.Refresh}" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </StackPanel>
      </Panel>
      </Grid>
    </Panel>
  </Grid>
</UserControl>
