<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop application: Avalonia views, design system and composition root. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Navigator</AssemblyName>
    <RootNamespace>Navigator.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\navigator.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Startup: ReadyToRun pre-compiles IL so less JIT work happens before the first frame. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Navigator.Core\Navigator.Core.csproj" />
    <ProjectReference Include="..\Navigator.Platform\Navigator.Platform.csproj" />
    <ProjectReference Include="..\Navigator.Updater\Navigator.Updater.csproj" />
    <ProjectReference Include="..\Navigator.Presentation\Navigator.Presentation.csproj" />
  </ItemGroup>

  <!-- Release builds get the update source and signing key from CI (see docs/UPDATER.md). -->
  <ItemGroup Condition="'$(UpdateRepository)' != ''">
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UpdatePublicKey)' != ''">
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(UpdatePublicKey)" />
  </ItemGroup>
</Project>
