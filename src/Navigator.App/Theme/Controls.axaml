<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Navigator.App.Controls">
  <!--
    Navigator control styles: an independently written Fluent-inspired restyle on top of the base templates.
    Only tokens from Tokens.axaml are used here.
  -->

  <!-- ── Typography ───────────────────────────────────────── -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource Font.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource Font.Display}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="{DynamicResource Font.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource Font.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Caption}" />
  </Style>
  <!-- "Conflicting file name" dialog: the count line and the "from → to" folder line -->
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="TextBlock.route">
    <Setter Property="Foreground" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Caption}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource Font.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,16,0,8" />
  </Style>

  <!-- ── Buttons ──────────────────────────────────────────── -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="12,4" />
    <!-- Labels sit in the middle of the button, also when MinWidth/MinHeight make it larger than its text -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Filled buttons: the template part draws the fill, so every state is set there with a matching label color
       (the base theme would otherwise swap in its own neutral hover/pressed colors or a light accent shade) -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.ForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter, Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions" Value="{DynamicResource Motion.Hover}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.ForegroundBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.PressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.PressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.ForegroundBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerForeground}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerForeground}" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.DangerPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.DangerForeground}" />
  </Style>

  <!-- Subtle (toolbar, title bar, row actions): transparent until hovered -->
  <Style Selector="Button.subtle, ToggleButton.subtle">
    <Setter Property="Background" Value="{DynamicResource Brush.Rest}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="{DynamicResource Size.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <!-- The template part owns the visible background, so the fade lives there (the base theme snaps it) -->
  <Style Selector="Button.subtle /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.subtle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions" Value="{DynamicResource Motion.Hover}" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Pressed}" />
  </Style>
  <Style Selector="ToggleButton.subtle:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent.SubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Rest}" />
  </Style>
  <Style Selector="Button.subtle:disabled c|IconView, Button.subtle:disabled TextBlock">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Width" Value="{DynamicResource Size.Control}" />
    <Setter Property="Height" Value="{DynamicResource Size.Control}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="c|IconView">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <!-- ── Text input ───────────────────────────────────────── -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextControlSelectionForegroundBrush}" />
    <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.omnibar">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
  </Style>
  <!-- Editable address box: fills the omnibar card edge-to-edge so its focus border follows the card's rounded outline -->
  <Style Selector="TextBox.address">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.CardInner}" />
  </Style>
  <!-- While editing, the address box's focus border replaces the card stroke (no double outline) -->
  <Style Selector="Border.omnibar-host.editing">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- Breadcrumb segment chevrons (sub-folder lists) and the drop-down arrow: narrow buttons inside the omnibar -->
  <Style Selector="Button.crumbchevron">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="3,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.crumbchevron c|IconView">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="MenuFlyoutPresenter.crumbs">
    <Setter Property="MaxHeight" Value="480" />
  </Style>
  <!-- Omnibar drop-down: autocompletion and typed-address history -->
  <Style Selector="Border.omnibar-dropdown">
    <Setter Property="Background" Value="{DynamicResource Brush.Flyout}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Overlay}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ListBox.suggestions">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="ListBox.suggestions ListBoxItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
  </Style>

  <!-- ── Flyouts, menus, tooltips ─────────────────────────── -->
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Overlay}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Flyout}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <!-- Icon strip on top of the item context menu: the row itself is inert, its buttons carry hover/press -->
  <Style Selector="MenuItem.quickactions">
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="MenuItem.quickactions:pointerover /template/ Border#PART_LayoutRoot, MenuItem.quickactions:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Overlay}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Flyout}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Caption}" />
  </Style>

  <!-- ── Thin scroll bars and progress ────────────────────── -->
  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="Background" Value="{DynamicResource Brush.ProgressTrack}" />
    <Setter Property="Transitions" Value="{DynamicResource Motion.Progress}" />
  </Style>

  <!-- ── Surfaces ─────────────────────────────────────────── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Space.Card}" />
  </Style>
  <Style Selector="Border.layer">
    <Setter Property="Background" Value="{DynamicResource Brush.Layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Layer}" />
  </Style>
  <Style Selector="Border.dialog-footer">
    <Setter Property="Background" Value="{DynamicResource Brush.LayerSolid}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Window.dialog">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
  </Style>

  <!-- Hoverable rows (sidebar entries, settings navigation, home cards, palette entries) -->
  <Style Selector="Border.hoverable">
    <Setter Property="Background" Value="{DynamicResource Brush.Rest}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Transitions" Value="{DynamicResource Motion.Hover}" />
  </Style>
  <Style Selector="Border.hoverable:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Border.hoverable.selected">
    <Setter Property="Background" Value="{DynamicResource Accent.SubtleBrush}" />
  </Style>
  <!-- Drag and drop on sidebar entries: outline = drop into the folder; top/bottom line = pin before/after it.
       Entries have a fixed height, so the border only shifts the content by a pixel and never relays out the list. -->
  <Style Selector="Border.hoverable.droptarget">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.hoverable.dropbefore">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>
  <Style Selector="Border.hoverable.dropafter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!-- Selection pill shown left of the selected sidebar / settings entry -->
  <Style Selector="Border.pill">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="scaleY(0)" />
    <Setter Property="Transitions" Value="{DynamicResource Motion.Indicator}" />
  </Style>
  <Style Selector="Border.selected > Panel > Border.pill, Border.selected > Grid > Border.pill">
    <Setter Property="RenderTransform" Value="scaleY(1)" />
  </Style>

  <!-- File rows -->
  <!-- The 1px border is always present (transparent) so selecting a row recolors it without a relayout -->
  <Style Selector="Border.item">
    <Setter Property="Background" Value="{DynamicResource Brush.Rest}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="Transitions" Value="{DynamicResource Motion.Hover}" />
  </Style>
  <Style Selector="Border.item:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Border.item.selected">
    <Setter Property="Background" Value="{DynamicResource Accent.SelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.SelectionBorderBrush}" />
  </Style>
  <!-- A slightly denser fill instead of dimming the whole row (an Opacity jump re-renders text and icons) -->
  <Style Selector="Border.item.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource Accent.SelectionHoverBrush}" />
  </Style>
  <Style Selector="Border.item.droptarget">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Brush}" />
  </Style>

  <!-- Tabs -->
  <Style Selector="Border.tab">
    <Setter Property="Background" Value="{DynamicResource Brush.Rest}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Tab}" />
    <Setter Property="Height" Value="{DynamicResource Size.Tab}" />
    <!-- Width comes from TabStripPanel: every tab gets the same one. -->
    <Setter Property="Padding" Value="12,0,6,0" />
    <Setter Property="Transitions" Value="{DynamicResource Motion.Hover}" />
  </Style>
  <Style Selector="Border.tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="Border.tab.selected">
    <Setter Property="Background" Value="{DynamicResource Brush.TabSelected}" />
  </Style>
  <!-- Items dragged over a tab: they will land in that tab's active pane folder. -->
  <Style Selector="Border.tab.droptarget">
    <Setter Property="Background" Value="{DynamicResource Accent.SubtleBrush}" />
  </Style>
  <Style Selector="Border.tab Button.tabclose">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions" Value="{DynamicResource Motion.Fade}" />
  </Style>
  <Style Selector="Border.tab:pointerover Button.tabclose, Border.tab.selected Button.tabclose">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Status center (file operations): tone colors for the toolbar ring, card badges and progress bars -->
  <Style Selector="c|ProgressRing">
    <Setter Property="Foreground" Value="{DynamicResource Accent.Brush}" />
    <Setter Property="TrackBrush" Value="{DynamicResource Brush.ProgressTrack}" />
    <Setter Property="Transitions" Value="{DynamicResource Motion.Progress}" />
  </Style>
  <Style Selector="c|IconView.tone-success">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
  </Style>
  <Style Selector="c|IconView.tone-warning">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="c|IconView.tone-error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="c|IconView.tone-muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <Style Selector="ProgressBar.tone-success">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
  </Style>
  <Style Selector="ProgressBar.tone-warning, ProgressBar.tone-paused">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="ProgressBar.tone-error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style Selector="ProgressBar.tone-muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
  </Style>
  <!-- Kind glyph in a soft accent disc; the outcome badge sits on its lower-right edge -->
  <Style Selector="Border.op-glyph">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{DynamicResource Accent.SubtleBrush}" />
  </Style>
  <Style Selector="Border.op-badge">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,-3,-3" />
  </Style>
  <Style Selector="Button.op-expander c|IconView">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions" Value="{DynamicResource Motion.Indicator}" />
  </Style>
  <Style Selector="Button.op-expander.expanded c|IconView">
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>

  <!-- Toasts -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource Brush.Flyout}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="BoxShadow" Value="{StaticResource Shadow.Flyout}" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Width" Value="340" />
  </Style>
</Styles>
