<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    Navigator design tokens. Views never hard-code colors, sizes, radii or durations: they reference these keys
    (DynamicResource for anything ThemeService changes at runtime). See docs/UI_SPECIFICATION.md.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Color.Window">#F3F3F3</Color>
      <SolidColorBrush x:Key="Brush.Window" Color="#F3F3F3" />
      <SolidColorBrush x:Key="Brush.Layer" Color="#FFFFFF" Opacity="0.72" />
      <SolidColorBrush x:Key="Brush.LayerSolid" Color="#FBFBFB" />
      <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.CardHover" Color="#F9F9F9" />
      <SolidColorBrush x:Key="Brush.Flyout" Color="#FCFCFC" />
      <SolidColorBrush x:Key="Brush.Stroke" Color="#E5E5E5" />
      <SolidColorBrush x:Key="Brush.StrokeStrong" Color="#D1D1D1" />
      <SolidColorBrush x:Key="Brush.Text" Color="#1B1B1B" />
      <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5F5F5F" />
      <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8B8B8B" />
      <SolidColorBrush x:Key="Brush.TextDisabled" Color="#A8A8A8" />
      <SolidColorBrush x:Key="Brush.Hover" Color="#000000" Opacity="0.04" />
      <SolidColorBrush x:Key="Brush.Pressed" Color="#000000" Opacity="0.025" />
      <SolidColorBrush x:Key="Brush.TabSelected" Color="#FFFFFF" Opacity="0.85" />
      <SolidColorBrush x:Key="Brush.Overlay" Color="#000000" Opacity="0.3" />
      <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C" />
      <SolidColorBrush x:Key="Brush.Warning" Color="#9D5D00" />
      <SolidColorBrush x:Key="Brush.Success" Color="#0F7B0F" />
      <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#000000" Opacity="0.08" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Color.Window">#202020</Color>
      <SolidColorBrush x:Key="Brush.Window" Color="#202020" />
      <SolidColorBrush x:Key="Brush.Layer" Color="#3A3A3A" Opacity="0.30" />
      <SolidColorBrush x:Key="Brush.LayerSolid" Color="#282828" />
      <SolidColorBrush x:Key="Brush.Card" Color="#2B2B2B" />
      <SolidColorBrush x:Key="Brush.CardHover" Color="#323232" />
      <SolidColorBrush x:Key="Brush.Flyout" Color="#2C2C2C" />
      <SolidColorBrush x:Key="Brush.Stroke" Color="#FFFFFF" Opacity="0.08" />
      <SolidColorBrush x:Key="Brush.StrokeStrong" Color="#FFFFFF" Opacity="0.16" />
      <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.TextSecondary" Color="#CFCFCF" />
      <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9E9E9E" />
      <SolidColorBrush x:Key="Brush.TextDisabled" Color="#6E6E6E" />
      <SolidColorBrush x:Key="Brush.Hover" Color="#FFFFFF" Opacity="0.06" />
      <SolidColorBrush x:Key="Brush.Pressed" Color="#FFFFFF" Opacity="0.04" />
      <SolidColorBrush x:Key="Brush.TabSelected" Color="#2E2E2E" Opacity="0.9" />
      <SolidColorBrush x:Key="Brush.Overlay" Color="#000000" Opacity="0.45" />
      <SolidColorBrush x:Key="Brush.Danger" Color="#FF99A4" />
      <SolidColorBrush x:Key="Brush.Warning" Color="#FCE100" />
      <SolidColorBrush x:Key="Brush.Success" Color="#6CCB5F" />
      <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#FFFFFF" Opacity="0.12" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Accent (replaced at runtime by ThemeService) -->
  <SolidColorBrush x:Key="Accent.Brush" Color="#0078D4" />
  <SolidColorBrush x:Key="Accent.SubtleBrush" Color="#0078D4" Opacity="0.16" />
  <SolidColorBrush x:Key="Accent.SelectionBrush" Color="#0078D4" Opacity="0.24" />
  <SolidColorBrush x:Key="Accent.ForegroundBrush" Color="#FFFFFF" />
  <x:Double x:Key="Window.TintOpacity">0.7</x:Double>

  <!-- Typography -->
  <FontFamily x:Key="Font.Family">Segoe UI Variable Text, Segoe UI, SF Pro Text, Inter, Cantarell, Noto Sans, Ubuntu, DejaVu Sans, sans-serif</FontFamily>
  <x:Double x:Key="Font.Caption">12</x:Double>
  <x:Double x:Key="Font.Body">14</x:Double>
  <x:Double x:Key="Font.Subtitle">16</x:Double>
  <x:Double x:Key="Font.Title">20</x:Double>
  <x:Double x:Key="Font.Display">28</x:Double>

  <!-- Sizes (density-dependent ones are overridden by ThemeService) -->
  <x:Double x:Key="Size.Row">32</x:Double>
  <x:Double x:Key="Size.Control">32</x:Double>
  <x:Double x:Key="Size.Tab">36</x:Double>
  <x:Double x:Key="Size.TabWidth">240</x:Double>
  <x:Double x:Key="Size.TabMinWidth">100</x:Double>
  <x:Double x:Key="Size.TitleBar">44</x:Double>
  <x:Double x:Key="Size.Icon">16</x:Double>
  <x:Double x:Key="Size.RowIcon">18</x:Double>
  <x:Double x:Key="Size.SidebarItem">36</x:Double>

  <!-- Spacing scale: 2, 4, 8, 12, 16, 24, 32 -->
  <Thickness x:Key="Space.Card">16</Thickness>
  <Thickness x:Key="Space.Page">32,24,32,32</Thickness>
  <Thickness x:Key="Space.Toolbar">8,4,8,4</Thickness>
  <Thickness x:Key="Space.Row">12,0,12,0</Thickness>
  <Thickness x:Key="Space.SidebarItem">12,0,8,0</Thickness>

  <!-- Corner radii -->
  <CornerRadius x:Key="Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="Radius.Card">8</CornerRadius>
  <!-- Radius.Card minus its 1px border: keeps controls nested edge-to-edge in a card concentric with it -->
  <CornerRadius x:Key="Radius.CardInner">7</CornerRadius>
  <CornerRadius x:Key="Radius.Overlay">8</CornerRadius>
  <CornerRadius x:Key="Radius.Tab">8,8,0,0</CornerRadius>
  <CornerRadius x:Key="Radius.Layer">8,0,0,0</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">2</CornerRadius>

  <!-- Elevation -->
  <BoxShadows x:Key="Shadow.Flyout">0 8 16 0 #24000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Dialog">0 32 64 0 #38000000</BoxShadows>
  <BoxShadows x:Key="Shadow.Card">0 2 4 0 #0F000000</BoxShadows>

  <!-- Motion (ThemeService replaces these according to the animation setting) -->
  <Transitions x:Key="Motion.Hover" />
  <Transitions x:Key="Motion.Fade" />
  <Transitions x:Key="Motion.FadeAndMove" />
  <Transitions x:Key="Motion.Indicator" />
  <sys:Boolean x:Key="Motion.Enabled">True</sys:Boolean>
  <sys:Boolean x:Key="Motion.Movement">True</sys:Boolean>
</ResourceDictionary>
